#!/bin/bash
set -e

# script/worktree — Create a git worktree with full local dev setup
#
# Canonical copy lives in GoCarrot/teak-hq — port changes from there, not
# from another repo's copy.
#
# Usage:
#   script/worktree <branch> [--from <base>] [path]
#
# Examples:
#   script/worktree feat/my-feature                        # off HEAD, or tracking origin/<branch> if it's there
#   script/worktree feat/my-feature --from develop         # fetch & branch off develop
#   script/worktree fix/bug-123 --from develop ~/custom    # explicit path + base

if [ -z "$1" ]; then
  echo "Usage: script/worktree <branch> [--from <base>] [path]"
  echo ""
  echo "  branch       Branch name to create or check out (e.g. feat/my-feature)"
  echo "  --from base  Base branch to branch from (fetches and fast-forwards first)"
  echo "  path         Worktree path (default: sibling of main repo)"
  exit 1
fi

branch="$1"
shift

base=""
worktree_path=""
while [ $# -gt 0 ]; do
  case "$1" in
    --from)
      base="$2"
      shift 2
      ;;
    *)
      worktree_path="$1"
      shift
      ;;
  esac
done

# Always derive sibling paths from the main worktree so naming is consistent
# regardless of which worktree you run this from.
main_tree="$(git worktree list --porcelain | head -1 | sed 's/worktree //')"
base_name="$(basename "$main_tree")"

if [ -z "$worktree_path" ]; then
  sanitized_branch="$(echo "$branch" | tr '/' '-')"
  worktree_path="$(dirname "$main_tree")/${base_name}-${sanitized_branch}"
fi

# --- Resolve the base commit ---

start_point=""
if [ -n "$base" ]; then
  echo "Fetching origin/$base..."
  git fetch origin "$base"

  # Try to fast-forward the local branch (works if not checked out elsewhere)
  if git fetch origin "$base:$base" 2>/dev/null; then
    echo "Fast-forwarded local $base"
  else
    echo "Could not fast-forward local $base (may be checked out), using origin/$base"
  fi

  start_point="origin/$base"
fi

if git show-ref --verify --quiet "refs/heads/$branch"; then
  target_ref="refs/heads/$branch"
  branch_exists=1
else
  branch_exists=0
  if [ -z "$start_point" ]; then
    # No local branch and no --from: if the branch is on origin, build from it
    # (tracking) rather than silently forking a same-named branch off HEAD.
    # ls-remote asks origin directly: 0 = there, 2 = absent, else the lookup
    # itself failed (offline, auth) -- refuse rather than fall back to HEAD.
    # A local origin/<branch> ref can't answer this: it may be stale.
    set +e
    git ls-remote --exit-code --heads origin "refs/heads/$branch" > /dev/null
    remote_status=$?
    set -e
    case "$remote_status" in
      0)
        echo "Fetching origin/$branch..."
        git fetch origin "+refs/heads/$branch:refs/remotes/origin/$branch"
        start_point="origin/$branch"
        track_remote=1
        ;;
      2) ;;
      *)
        echo "Refusing: could not check origin for $branch (ls-remote exit $remote_status) -- not branching off HEAD in case it exists there" >&2
        exit 1
        ;;
    esac
  fi
  target_ref="${start_point:-HEAD}"
fi

echo ""
echo "Creating worktree:"
echo "  Path:   $worktree_path"
echo "  Branch: $branch"
if [ "$branch_exists" = 1 ]; then
  echo "  Base:   $target_ref (existing local branch)"
elif [ "${track_remote:-}" = 1 ]; then
  echo "  Base:   $start_point (existing remote branch)"
elif [ -n "$base" ]; then
  echo "  Base:   $start_point"
fi
echo ""

# --- Guard + hook wiring ---
#
# Only when this repo guards its refs with .githooks at all. SDK repos have
# no .githooks; wiring core.hooksPath there would point the whole repo at a
# missing directory, and the check below would refuse every ref.
if [ -d "$main_tree/.githooks" ]; then
  # Check the ref the new worktree will actually be built from first: an old
  # branch, or a --from base, can predate .githooks, in which case wiring
  # core.hooksPath would point a relative hooksPath at a directory that isn't
  # there and silently guard nothing. target_ref resolves against this
  # invoking worktree (not -C "$main_tree"): refs/heads/* and origin/* are
  # shared across worktrees, but a bare HEAD means the invoking worktree's
  # HEAD, same as `git worktree add` uses below.
  if ! git cat-file -e "$target_ref:.githooks/reference-transaction" 2>/dev/null; then
    echo "Refusing: $target_ref does not have .githooks/reference-transaction -- the new worktree would be unguarded even though core.hooksPath is wired" >&2
    if [ "${track_remote:-}" = 1 ]; then
      echo "  (merge the default branch into $branch and push, then retry)" >&2
    fi
    exit 1
  fi

  # Only wire core.hooksPath -- repo-shared config, not per-worktree -- once
  # the above confirms the new worktree will actually have the hook file.
  # Doing this before that check would write hooksPath into the shared config
  # on a path that then refuses, leaving main_tree pointed at a directory that
  # doesn't exist there yet -- which disables every hook in the repo, not just
  # this one, until main_tree happens to catch up.
  "$(dirname "$0")/install_git_hooks" "$main_tree"
  if [ "$(git -C "$main_tree" config --get core.hooksPath)" != ".githooks" ]; then
    echo "Refusing: core.hooksPath is not wired to .githooks -- worktree would be unguarded" >&2
    exit 1
  fi
fi

# Create the worktree — use existing branch if it exists, otherwise create it
if [ "$branch_exists" = 1 ]; then
  git worktree add "$worktree_path" "$branch"
else
  if [ "${track_remote:-}" = 1 ]; then
    git worktree add --track -b "$branch" "$worktree_path" "$start_point"
  elif [ -n "$start_point" ]; then
    git worktree add -b "$branch" "$worktree_path" "$start_point"
  else
    git worktree add -b "$branch" "$worktree_path"
  fi
fi

"$(dirname "$0")/set_worktree_identity" "$main_tree" "$worktree_path"

# --- Dependencies & local config ---
#
# The same script ships in every Teak repo, so each step fires only when
# the repo it's running in actually has that stack.

# Node via nvm, pinned to .nvmrc. Before any JS install, whether that runs
# here or inside rake worktree:setup.
# Switch in this shell, not a subshell -- a subshell's PATH change never
# reaches yarn install.
if [ -f "$worktree_path/.nvmrc" ]; then
  if [ -d "${NVM_DIR:-$HOME/.nvm}" ]; then
    export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
    . "$NVM_DIR/nvm.sh"
    echo "Setting up Node..."
    pinned_node="$(cat "$worktree_path/.nvmrc")"
    nvm use "$pinned_node" || nvm install "$pinned_node"
  else
    echo "WARNING: .nvmrc present but nvm not found — skipping Node setup" >&2
  fi
fi

# Ruby dependencies, when this repo has a Gemfile.
#
# Must install the pinned Ruby AND route every `bundle`/`rake` invocation
# through it explicitly — a bare invocation resolves via whatever's first on
# PATH, which can silently be an older Ruby if a shim/rvm/rbenv init isn't
# already ahead of system Ruby in that subshell's PATH. That's exactly how a
# css_parser 3.0.0 -> 1.22.0 downgrade (dropping ssrf_filter, reopening
# CVE-2026-53727) got generated once before: a valid-looking `bundle install`
# re-resolved a Ruby-3.3-gated gem down under an unintentionally-active older
# Ruby. `rbenv exec`/`rvm ... do` (unlike a bare invocation, or `rvm use`
# which doesn't reliably take in a non-interactive subshell) ignore PATH
# order and always run under the pinned version. Each setup step below runs
# in its own subshell, so `ruby_exec` is defined once and reused for all of
# them rather than routing each bare call individually.
rake_setup=""
if [ -f "$worktree_path/Gemfile" ]; then
  echo "Installing Ruby dependencies..."
  if [ -f "$worktree_path/.ruby-version" ]; then
    ruby_version="$(sed 's/^ruby-//' "$worktree_path/.ruby-version")"
    if which rbenv > /dev/null; then
      (cd "$worktree_path" && rbenv install --skip-existing "$ruby_version" && rbenv rehash)
      ruby_exec() { (cd "$worktree_path" && rbenv exec "$@"); }
    elif which rvm > /dev/null; then
      (cd "$worktree_path" && rvm install "$ruby_version")
      # --create is a no-op when the gemset already exists, so this doubles as
      # first-call gemset creation without a separate setup step.
      ruby_exec() { (cd "$worktree_path" && rvm --create "$ruby_version@$(cat .ruby-gemset)" "do" "$@"); }
    else
      echo "Refusing: .ruby-version is pinned but neither rbenv nor rvm is available -- a bare bundle install would run under an arbitrary Ruby" >&2
      exit 1
    fi
    ruby_exec bundle install
  else
    # No pin in this repo (e.g. a rake-only SDK); bundle under ambient Ruby.
    ruby_exec() { (cd "$worktree_path" && "$@"); }
    ruby_exec bundle install
  fi

  # Repos with a worktree:setup task delegate repo-specific steps (asset
  # precompile, .env/.claude copies, JS deps) to it, as before. Detect by
  # dry-running rake, not by grepping task files: the name is composed from
  # namespace + task, so the literal "worktree:setup" appears nowhere in the
  # .rake source.
  if ruby_exec bundle exec rake -n worktree:setup > /dev/null 2>&1; then
    rake_setup=1
    echo "Running worktree setup..."
    ruby_exec bundle exec rake worktree:setup
  fi
  if ruby_exec bundle exec rake -n db:idempotent_setup > /dev/null 2>&1; then
    echo "Setting up database..."
    ruby_exec bundle exec rake db:idempotent_setup
  fi
fi

# Repos whose setup isn't rake-driven do the generic steps inline.
if [ -z "$rake_setup" ]; then
  # --- Copy local config from main worktree ---
  if [ -f "$main_tree/.env" ]; then
    cp "$main_tree/.env" "$worktree_path/.env"
    echo "Copied .env"
  fi

  if [ -f "$main_tree/.claude/settings.local.json" ]; then
    mkdir -p "$worktree_path/.claude"
    cp "$main_tree/.claude/settings.local.json" "$worktree_path/.claude/settings.local.json"
    echo "Copied .claude/settings.local.json"
  fi

  # --- JS dependencies ---
  if [ -f "$worktree_path/package.json" ]; then
    if [ -f "$worktree_path/yarn.lock" ]; then
      echo "Installing JS dependencies (yarn)..."
      (cd "$worktree_path" && yarn install)
    elif [ -f "$worktree_path/package-lock.json" ]; then
      echo "Installing JS dependencies (npm ci --ignore-scripts)..."
      (cd "$worktree_path" && npm ci --ignore-scripts)
    else
      echo "Installing JS dependencies (npm install --ignore-scripts)..."
      (cd "$worktree_path" && npm install --ignore-scripts)
    fi
  fi
fi

echo ""
echo "Worktree ready at: $worktree_path"
echo "  cd $worktree_path"
